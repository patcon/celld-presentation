{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celld-presentation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "DECK", "class_name": "Deck" },
      // A stand-in, only to see how a second cell renders in the fleet diagram.
      { "name": "DUMMY", "class_name": "Dummy" }
    ]
  },
  "r2_buckets": [{ "binding": "SELFIES", "bucket_name": "celld-presentation-selfies" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Deck"] },
    { "tag": "v2", "new_sqlite_classes": ["Dummy"] }
  ]
}
