{
  "name": "celld-presentation",
  "version": "1.0.0",
  "description": "Interactive presentation on celld and Durable Objects",
  "scripts": {
    "dev": "pnpm wrangler:dev",
    "wrangler:dev": "vite",
    "wrangler:dev:share": "SHARE=1 vite",
    "celld:build": "CELLD=1 vite build",
    "celld:serve": "CELLD_IDLE_EVICT_S=10 CELLD_SHUTDOWN_TOTAL_MS=8000 celld dev --host --port 5173 --watch-ignore 'dist/celld_presentation/**'",
    "celld:dev": "pnpm celld:build && concurrently -k -n vite,celld,operator \"CELLD=1 vite build --watch\" \"pnpm celld:serve\" \"node scripts/celld-operator.ts\"",
    "celld:dev:share": "pnpm celld:build && concurrently -k -n vite,celld,operator,tunnel \"CELLD=1 vite build --watch\" \"pnpm celld:serve\" \"node scripts/celld-operator.ts\" \"node scripts/tunnel.ts http://localhost:5173\"",
    "celld:state": "node scripts/celld-state.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc && tsc -p worker && tsc -p tsconfig.node.json"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@shikijs/magic-move": "^4.5.0",
    "hono": "^4.13.13",
    "partysocket": "^1.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0"
  }
}
